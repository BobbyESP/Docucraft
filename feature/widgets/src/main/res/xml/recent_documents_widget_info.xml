<?xml version="1.0" encoding="utf-8"?><!--
    Placed four cells wide and two tall, and no smaller than three by two: a row needs the width for
    a name. It asks for no update on a timer; the app tells it when the library changes.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_recents_description"
    android:initialLayout="@layout/widget_recents"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_recents_preview"
    android:previewLayout="@layout/widget_recents_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
