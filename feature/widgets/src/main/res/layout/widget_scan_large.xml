<?xml version="1.0" encoding="utf-8"?><!-- Two cells each way or more: the title at the top, the button in the corner the thumb reaches. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_primary_container"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="12dp"
    tools:ignore="UseAppTint">

    <TextView
        android:id="@+id/widget_scan_title"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="52dp"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="top|start"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:text="@string/widget_scan_title"
        android:textColor="@color/widget_on_primary_container"
        android:textSize="20sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/widget_chip_primary">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/rounded_document_scanner_24"
            android:tint="@color/widget_on_primary" />
    </FrameLayout>
</FrameLayout>
