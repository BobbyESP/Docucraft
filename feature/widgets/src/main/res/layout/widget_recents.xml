<?xml version="1.0" encoding="utf-8"?>
<!--
    The header with its two buttons, then either the rows, which the receiver adds, or what is said
    when there is no document to list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="8dp"
    tools:ignore="UseAppTint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_recents_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/recents"
            android:textColor="@color/widget_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_recents_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_chip_tonal"
            android:contentDescription="@string/search_documents"
            android:padding="9dp"
            android:src="@drawable/widget_ic_search"
            android:tint="@color/widget_on_primary_container" />

        <ImageView
            android:id="@+id/widget_recents_scan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_chip_primary"
            android:contentDescription="@string/widget_scan_title"
            android:padding="9dp"
            android:src="@drawable/rounded_document_scanner_24"
            android:tint="@color/widget_on_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_recents_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_recents_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/widget_recents_empty"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
