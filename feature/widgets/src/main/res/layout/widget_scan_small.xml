<?xml version="1.0" encoding="utf-8"?><!-- One cell: there is room for the icon and nothing else. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_primary"
    android:clipToOutline="true"
    android:contentDescription="@string/widget_scan_title"
    android:foreground="?android:attr/selectableItemBackground"
    tools:ignore="UseAppTint">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/rounded_document_scanner_24"
        android:tint="@color/widget_on_primary" />
</FrameLayout>
