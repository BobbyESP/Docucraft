<?xml version="1.0" encoding="utf-8"?><!-- What the widget picker shows below Android 12, where it cannot draw the layout itself. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="240dp"
                android:height="120dp" />
            <corners android:radius="28dp" />
            <solid android:color="@color/widget_surface" />
        </shape>
    </item>
    <item
        android:width="40dp"
        android:height="40dp"
        android:drawable="@drawable/widget_chip_primary"
        android:gravity="top|end"
        android:right="8dp"
        android:top="8dp" />
    <item
        android:bottom="8dp"
        android:drawable="@drawable/widget_row"
        android:left="8dp"
        android:right="8dp"
        android:top="60dp" />
</layer-list>
