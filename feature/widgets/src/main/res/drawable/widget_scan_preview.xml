<?xml version="1.0" encoding="utf-8"?><!-- What the widget picker shows below Android 12, where it cannot draw the layout itself. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="168dp"
                android:height="64dp" />
            <corners android:radius="28dp" />
            <solid android:color="@color/widget_primary_container" />
        </shape>
    </item>
    <item
        android:width="40dp"
        android:height="40dp"
        android:drawable="@drawable/widget_chip_primary"
        android:gravity="center" />
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/rounded_document_scanner_24"
        android:gravity="center" />
</layer-list>
